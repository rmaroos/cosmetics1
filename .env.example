# ─── WhatsApp Support Widget ──────────────────────────────────────────────────
# Your WhatsApp number in international format without + or spaces.
# Example: 94712345678  (Sri Lanka country code 94, then 9-digit number)
VITE_WHATSAPP_NUMBER=

# Pre-filled message customers see when they open WhatsApp.
# Leave blank to use the default message.
VITE_WHATSAPP_MESSAGE=Hello! I need help with my order.

# ─── Instalment / BNPL Payment Options ───────────────────────────────────────
# Set to true to show payment instalment rows on product cards.
VITE_SHOW_INSTALMENTS=false

# Number of instalments shown to the customer (e.g. 3).
VITE_INSTALMENT_COUNT=3

# Cashback percentage offered by the primary provider (e.g. 8 for 8%).
VITE_INSTALMENT_CASHBACK_PCT=8

# Comma-separated short names for the primary instalment providers.
# These are displayed as text badges on the card.
# Example: amipay,mintpay
VITE_INSTALMENT_PROVIDERS=

# Secondary BNPL provider displayed on a second payment line (e.g. Koko).
# Leave blank to hide the second line.
VITE_BNPL_PROVIDER=

